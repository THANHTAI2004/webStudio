{
  "name": "studio-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:web": "npm --prefix apps/web run dev",
    "dev:admin": "npm --prefix apps/admin run dev",
    "dev:api": "npm --prefix apps/api run start:dev",
    "build:web": "npm --prefix apps/web run build",
    "build:admin": "npm --prefix apps/admin run build",
    "build:api": "npm --prefix apps/api run build",
    "mongo:up": "docker compose up -d mongodb",
    "mongo:down": "docker compose stop mongodb",
    "mongo:logs": "docker compose logs -f mongodb"
  }
}
