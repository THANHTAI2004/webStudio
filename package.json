{
  "name": "studio-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:web": "npm --prefix apps/web run dev",
    "dev:admin": "npm --prefix apps/admin run dev",
    "dev:api": "npm --prefix apps/api run start:dev",
    "build:web": "npm --prefix apps/web run build",
    "build:admin": "npm --prefix apps/admin run build",
    "build:api": "npm --prefix apps/api run build",
    "mongo:up": "docker compose up -d mongodb",
    "mongo:down": "docker compose stop mongodb",
    "mongo:logs": "docker compose logs -f mongodb",
    "prod:config": "docker compose --env-file .env.production -f docker-compose.prod.yml config",
    "prod:build": "docker compose --env-file .env.production -f docker-compose.prod.yml build",
    "prod:up": "docker compose --env-file .env.production -f docker-compose.prod.yml up -d",
    "prod:down": "docker compose --env-file .env.production -f docker-compose.prod.yml stop",
    "prod:logs": "docker compose --env-file .env.production -f docker-compose.prod.yml logs -f",
    "prod:ps": "docker compose --env-file .env.production -f docker-compose.prod.yml ps",
    "backup:run": "docker compose --env-file .env.production -f docker-compose.prod.yml run --rm backup /backup/run-once.sh"
  }
}
