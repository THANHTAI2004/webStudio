NODE_ENV=production

STUDIO_DOMAIN=studio.example.com
ADMIN_DOMAIN=admin.studio.example.com
NEXT_PUBLIC_SITE_URL=https://studio.example.com
NEXT_PUBLIC_API_URL=/api/v1
API_INTERNAL_URL=http://api:4000/api/v1

MONGO_ROOT_USERNAME=studio_root
MONGO_ROOT_PASSWORD=CHANGE_ME_LONG_RANDOM_ROOT_PASSWORD
MONGO_APP_USERNAME=studio_app
MONGO_APP_PASSWORD=CHANGE_ME_LONG_RANDOM_APP_PASSWORD
MONGO_DATABASE=studio
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_AUTH_SOURCE=studio

JWT_ACCESS_SECRET=CHANGE_ME_LONG_RANDOM_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_LONG_RANDOM_REFRESH_SECRET
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

ADMIN_SEED_NAME=Studio Admin
ADMIN_SEED_EMAIL=admin@studio.local
ADMIN_SEED_PASSWORD=CHANGE_ME_LONG_RANDOM_ADMIN_PASSWORD

STUDIO_TIMEZONE=Asia/Ho_Chi_Minh
CORS_ORIGINS=https://studio.example.com,https://admin.studio.example.com

UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=25
MAX_UPLOAD_FILES=20
MEDIA_URL_PREFIX=/uploads

COOKIE_SECURE=true
TRUST_PROXY=true
SWAGGER_ENABLED=false
SERVE_UPLOADS=false

BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400

CERTBOT_EMAIL=admin@example.com
CERTBOT_IMAGE=certbot/certbot:v2.11.0
