NODE_ENV=development
PORT=4000

MONGODB_URI=mongodb://studio_admin:change-me@localhost:27017/studio?authSource=admin
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=studio
MONGO_APP_USERNAME=studio_admin
MONGO_APP_PASSWORD=change-me
MONGO_AUTH_SOURCE=admin

JWT_ACCESS_SECRET=change-this-access-secret
JWT_REFRESH_SECRET=change-this-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

ADMIN_SEED_NAME=Studio Admin
ADMIN_SEED_EMAIL=admin@studio.local
ADMIN_SEED_PASSWORD=change-this-password

CORS_ORIGINS=http://localhost:3000,http://localhost:3001
STUDIO_TIMEZONE=Asia/Ho_Chi_Minh

UPLOAD_DIR=../../data/uploads
MAX_UPLOAD_MB=25
MAX_UPLOAD_FILES=20
MEDIA_URL_PREFIX=/uploads

COOKIE_SECURE=false
TRUST_PROXY=false
SWAGGER_ENABLED=true
SERVE_UPLOADS=true
